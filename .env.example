# TMDB (https://www.themoviedb.org/settings/api)
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Postgres — Neon free tier works (https://console.neon.tech)
# Must support the pg_trgm extension. Connection string includes ?sslmode=require.
DATABASE_URL=

# Streaming Availability (optional — paid; app falls back to TMDB+JustWatch links)
RAPIDAPI_KEY=
STREAMING_AVAILABILITY_HOST=streaming-availability.p.rapidapi.com

# Upstash Redis (optional — falls back to in-memory cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest (optional — only needed when running crons)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Blob (optional — for chunked sitemap uploads)
BLOB_READ_WRITE_TOKEN=

# Seed cap — pages × 2 media types × 20 results. Default 250 (~10K titles). Max 500 (~20K).
SEED_PAGES_PER_TYPE=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
